{
  "@context": [
    "https://www.w3.org/ns/solid/oidc-context.jsonld",
    {
      "interop": "http://www.w3.org/ns/solid/interop#"
    }
  ],
  "client_id": "https://solid-app-gallery.mpeters.dev/id.jsonld",
  "client_name": "Solid App Gallery",
  "client_uri": "https://solid-app-gallery.mpeters.dev/",
  "logo_uri": "https://solid-app-gallery.mpeters.dev/icons/icon-512.png",
  "redirect_uris": [
    "https://solid-app-gallery.mpeters.dev/",
    "http://localhost:5180/"
  ],
  "post_logout_redirect_uris": [
    "https://solid-app-gallery.mpeters.dev/",
    "http://localhost:5180/"
  ],
  "scope": "openid profile offline_access webid",
  "grant_types": [
    "refresh_token",
    "authorization_code"
  ],
  "response_types": [
    "code"
  ],
  "token_endpoint_auth_method": "none",
  "interop:hasAccessNeedGroup": "https://solid-app-gallery.mpeters.dev/sai/access-needs.ttl#gallery-contributions-v1",
  "interop:hasAuthorizationCallbackEndpoint": "https://solid-app-gallery.mpeters.dev/"
}
