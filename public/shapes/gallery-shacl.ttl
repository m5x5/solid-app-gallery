# SHACL shapes for the gallery's media + social layer that the catalog schema
# doesn't cover: screenshots, flows, videos (schema.org) and comments (Web
# Annotations). These are validated CLIENT-SIDE / in CI — Solid pods (CSS) don't
# enforce SHACL on write, so the gallery is the contract enforcer.
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema:  <http://schema.org/> .
@prefix ex:      <http://example.org#> .
@prefix con:     <https://solidproject.solidcommunity.net/catalog/taxonomy#> .
@prefix oa:      <http://www.w3.org/ns/oa#> .
@prefix as:      <https://www.w3.org/ns/activitystreams#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix :        <https://solidproject.solidcommunity.net/catalog/gallery-shapes#> .

# --- association: assets hang off the catalog's ex:Software node ---
:AppAssetsShape a sh:NodeShape ;
  sh:targetClass ex:Software ;
  sh:property [
    sh:path ex:screenshot ; sh:nodeKind sh:IRI ; sh:node :ImageObjectShape ;
    sh:name "screenshot" ; sh:description "App screenshots (forward-linked)."
  ] , [
    sh:path ex:flow ; sh:nodeKind sh:IRI ; sh:node :FlowShape ;
    sh:name "flow" ; sh:description "Ordered screen sequences."
  ] , [
    sh:path schema:video ; sh:nodeKind sh:IRI ; sh:node :VideoObjectShape ;
    sh:name "video"
  ] .

:ImageObjectShape a sh:NodeShape ;
  sh:targetClass schema:ImageObject ;
  sh:property
    [ sh:path schema:contentUrl    ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ,
    [ sh:path schema:thumbnailUrl  ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ,
    [ sh:path schema:encodingFormat; sh:datatype xsd:string ; sh:maxCount 1 ] ,
    [ sh:path schema:width         ; sh:datatype xsd:integer ; sh:maxCount 1 ] ,
    [ sh:path schema:height        ; sh:datatype xsd:integer ; sh:maxCount 1 ] ,
    [ sh:path schema:caption       ; sh:datatype xsd:string ; sh:maxCount 1 ] ,
    [ sh:path schema:keywords      ; sh:nodeKind sh:IRI ;
      sh:description "Screen-pattern as a SKOS concept (con:LoginScreen, …), or con:HighlightScreen marking a screen the gallery card features." ] ,
    [ sh:path dcterms:created      ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] ,
    [ sh:path dcterms:creator      ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] .

:VideoObjectShape a sh:NodeShape ;
  sh:targetClass schema:VideoObject ;
  sh:property
    [ sh:path schema:contentUrl     ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ,
    [ sh:path schema:encodingFormat ; sh:datatype xsd:string ; sh:maxCount 1 ] ,
    [ sh:path schema:name           ; sh:datatype xsd:string ; sh:maxCount 1 ] ,
    [ sh:path schema:duration       ; sh:datatype xsd:duration ; sh:maxCount 1 ] .

# --- flows: an ordered list of screens ---
:FlowShape a sh:NodeShape ;
  sh:targetClass schema:ItemList ;
  sh:property
    [ sh:path schema:name            ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ,
    [ sh:path ex:flowAction          ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ,
    [ sh:path schema:numberOfItems   ; sh:datatype xsd:integer ; sh:maxCount 1 ] ,
    [ sh:path schema:itemListElement ; sh:node :ListItemShape ; sh:minCount 1 ] .

:ListItemShape a sh:NodeShape ;
  sh:targetClass schema:ListItem ;
  sh:property
    [ sh:path schema:position ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ,
    [ sh:path schema:item     ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] .

# --- comments: W3C Web Annotations (back-linked from the author's pod) ---
:AnnotationShape a sh:NodeShape ;
  sh:targetClass oa:Annotation ;
  sh:property
    [ sh:path oa:motivatedBy  ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ,
    [ sh:path oa:hasTarget    ; sh:minCount 1 ] ,
    [ sh:path oa:hasBody      ; sh:minCount 1 ] ,
    [ sh:path as:attributedTo ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ,
    [ sh:path as:audience     ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ,
    [ sh:path dcterms:created ; sh:datatype xsd:dateTime ; sh:maxCount 1 ] .

# --- data regions: a box on a screenshot naming the vocabulary term the app
# shows (oa:describing) or lets the user edit (oa:editing) there. The
# target is a SpecificResource on the screenshot with a media-fragment
# selector in percent; the body a SpecificResource whose source is the term.
# An app's data shape is derived from the set of these (lib/shapes).
:DataRegionShape a sh:NodeShape ;
  sh:targetClass oa:Annotation ;
  # Data regions and comments are both oa:Annotations. Ignore annotations with
  # another motivation; describing/editing annotations must satisfy the full
  # region contract below.
  sh:or (
    [ sh:not [
        sh:property [
          sh:path oa:motivatedBy ;
          sh:in ( oa:describing oa:editing ) ;
          sh:minCount 1
        ]
      ]
    ]
    [ sh:property
        [ sh:path oa:motivatedBy ; sh:in ( oa:describing oa:editing ) ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path oa:hasTarget   ; sh:node :RegionTargetShape ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path oa:hasBody     ; sh:node :RegionBodyShape ; sh:minCount 1 ] ,
        [ sh:path ( oa:hasBody :termKind ) ; sh:in ( "property" "class" ) ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path dcterms:creator ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ,
        [ sh:path dcterms:created ; sh:datatype xsd:dateTime ; sh:maxCount 1 ]
    ]
  ) .

:RegionTargetShape a sh:NodeShape ;
  sh:property
    [ sh:path oa:hasSource   ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
      sh:description "The screenshot (schema:ImageObject contentUrl) the box was drawn on." ] ,
    [ sh:path oa:hasScope    ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
      sh:description "The ex:Software record the screen belongs to." ] ,
    [ sh:path oa:hasSelector ; sh:node :RegionSelectorShape ; sh:minCount 1 ; sh:maxCount 1 ] .

:RegionSelectorShape a sh:NodeShape ;
  sh:targetClass oa:FragmentSelector ;
  sh:property
    [ sh:path dcterms:conformsTo ; sh:hasValue <http://www.w3.org/TR/media-frags/> ] ,
    [ sh:path rdf:value ; sh:datatype xsd:string ; sh:pattern "^xywh=percent:[0-9.]+,[0-9.]+,[0-9.]+,[0-9.]+$" ;
      sh:minCount 1 ; sh:maxCount 1 ] .

:RegionBodyShape a sh:NodeShape ;
  sh:or (
    [ sh:property [ sh:path oa:hasSource ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:description "The vocabulary term (property or class) shown in the box." ] ,
      [ sh:path oa:hasPurpose ; sh:hasValue oa:identifying ] ,
      [ sh:path :termKind ; sh:in ( "property" "class" ) ; sh:minCount 1 ; sh:maxCount 1 ] ]
    [ sh:property [ sh:path rdf:value ; sh:datatype xsd:string ; sh:minCount 1 ] ,
      [ sh:path oa:hasPurpose ; sh:hasValue oa:describing ] ]
    [ sh:property [ sh:path oa:hasSource ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ] ,
      [ sh:path oa:hasPurpose ; sh:hasValue oa:classifying ] ]
  ) .
