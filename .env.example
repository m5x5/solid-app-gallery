# Copy to .env and fill in. Used by the seed/capture scripts and e2e tests
# (Node-side only — never bundled into the deployed app).
TEST_POD_IDP=https://your-pod-provider/
TEST_POD_EMAIL=you@example.com
TEST_POD_PASSWORD=your-password

# Shown on the Participation page's "Become a moderator" section so people can
# reach the admin on Matrix (e.g. "@you:matrix.org"). Bundled into the app.
VITE_ADMIN_MATRIX=

# Sentry / Bugsink DSN for error tracking. Bundled into the app.
VITE_SENTRY_DSN=
